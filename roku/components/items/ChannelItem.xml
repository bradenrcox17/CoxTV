<?xml version="1.0" encoding="utf-8"?>
<!-- Channel row. No logo on purpose: with thousands of channels, image loading is the
     slowest part of scrolling. The logo is shown in the player once a channel plays. -->
<component name="ChannelItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="focusPercent" type="float" onChange="onFocus" />
    <field id="listHasFocus" type="boolean" onChange="onFocus" />
  </interface>
  <script type="text/brightscript" uri="ChannelItem.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <children>
    <Rectangle id="mineBg" width="1280" height="100" color="0x3A2410FF" visible="false" />
    <Rectangle id="bg" width="1280" height="100" color="0xFF8200FF" opacity="0" />
    <Label id="num" translation="[20,0]" width="110" height="100" vertAlign="center" color="0xA3A3A8FF"><Font role="font" uri="pkg:/fonts/geist_mono.ttf" size="34" /></Label>
    <Label id="name" translation="[140,10]" width="1040" height="46" color="0xEDEDEDFF"><Font role="font" uri="pkg:/fonts/geist_semibold.ttf" size="34" /></Label>
    <Label id="now" translation="[140,52]" width="1040" height="32" color="0xC2C2C6FF"><Font role="font" uri="pkg:/fonts/geist_regular.ttf" size="26" /></Label>
    <Rectangle id="barBg" translation="[140,93]" width="400" height="4" color="0xFFFFFF33" />
    <Rectangle id="bar" translation="[140,93]" width="0" height="4" color="0xFF8200FF" />
    <Poster id="star" translation="[1208,32]" width="36" height="36" uri="pkg:/images/star.png" blendColor="0xFF8200FF" visible="false" />
  </children>
</component>
