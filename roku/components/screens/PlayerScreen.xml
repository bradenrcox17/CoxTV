<?xml version="1.0" encoding="utf-8"?>
<component name="PlayerScreen" extends="BaseScreen">
  <interface>
    <!-- "up" / "down" / "prev" from the remote (see MainScene) -->
    <field id="remote" type="string" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="PlayerScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <children>
    <Rectangle id="black" width="1920" height="1080" color="0x000000FF" />
    <Video id="video" width="1920" height="1080" enableUI="false" />

    <Label id="loading" translation="[0,500]" width="1920" horizAlign="center" text="Loading..." color="0xFFFFFFFF" visible="false"><Font role="font" uri="pkg:/fonts/geist_bold.ttf" size="46" /></Label>
    <Group id="badge" visible="false">
      <Rectangle translation="[1500,50]" width="370" height="64" color="0x000000B3" />
      <Label id="badgeText" translation="[1500,50]" width="370" height="64" horizAlign="center" vertAlign="center" color="0xFFFFFFFF"><Font role="font" uri="pkg:/fonts/geist_semibold.ttf" size="28" /></Label>
    </Group>

    <Group id="errorBox" visible="false">
      <Rectangle translation="[410,370]" width="1100" height="300" color="0x000000D9" />
      <Label id="errorTitle" translation="[440,410]" width="1040" horizAlign="center" wrap="true" color="0xFFFFFFFF"><Font role="font" uri="pkg:/fonts/geist_bold.ttf" size="46" /></Label>
      <Label id="errorMsg" translation="[440,500]" width="1040" horizAlign="center" wrap="true" maxLines="2" color="0xA3A3A8FF"><Font role="font" uri="pkg:/fonts/geist_regular.ttf" size="28" /></Label>
      <Label translation="[440,600]" width="1040" horizAlign="center" text="Press OK to try again, or Up / Down to change channel" color="0xA3A3A8FF"><Font role="font" uri="pkg:/fonts/geist_regular.ttf" size="28" /></Label>
    </Group>

    <Group id="info" visible="false">
      <Poster translation="[0,560]" width="1920" height="520" uri="pkg:/images/gradient.png" />
      <Rectangle translation="[90,750]" width="220" height="124" color="0x1E1E21FF" />
      <Label id="infoInitials" translation="[90,750]" width="220" height="124" horizAlign="center" vertAlign="center" color="0xA3A3A8FF"><Font role="font" uri="pkg:/fonts/geist_semibold.ttf" size="34" /></Label>
      <Poster id="infoLogo" translation="[90,750]" width="220" height="124" loadDisplayMode="scaleToFit" />
      <Label id="infoNum" translation="[90,890]" width="220" horizAlign="center" color="0xFFFFFFFF"><Font role="font" uri="pkg:/fonts/geist_mono.ttf" size="46" /></Label>
      <Poster id="infoFav" translation="[360,742]" width="40" height="40" uri="pkg:/images/star.png" visible="false" />
      <Label id="infoName" translation="[360,734]" width="1150" color="0xFFFFFFFF"><Font role="font" uri="pkg:/fonts/geist_bold.ttf" size="46" /></Label>
      <Label id="infoClock" translation="[1530,740]" width="300" horizAlign="right" color="0xA3A3A8FF"><Font role="font" uri="pkg:/fonts/geist_regular.ttf" size="34" /></Label>
      <Label id="infoTitle" translation="[360,800]" width="1470" color="0xFF8200FF"><Font role="font" uri="pkg:/fonts/geist_semibold.ttf" size="34" /></Label>
      <Label id="infoTime" translation="[360,852]" width="360" color="0xA3A3A8FF"><Font role="font" uri="pkg:/fonts/geist_regular.ttf" size="28" /></Label>
      <Rectangle id="infoBarBg" translation="[730,866]" width="600" height="6" color="0xFFFFFF33" />
      <Rectangle id="infoBar" translation="[730,866]" width="0" height="6" color="0xFF8200FF" />
      <Label id="infoLeft" translation="[1350,852]" width="300" color="0xA3A3A8FF"><Font role="font" uri="pkg:/fonts/geist_regular.ttf" size="28" /></Label>
      <Label id="infoDesc" translation="[360,900]" width="1470" height="84" wrap="true" maxLines="2" color="0xDEDEDEFF"><Font role="font" uri="pkg:/fonts/geist_regular.ttf" size="28" /></Label>
      <Label id="infoNext" translation="[360,988]" width="1470" color="0xA3A3A8FF"><Font role="font" uri="pkg:/fonts/geist_regular.ttf" size="28" /></Label>
      <Label translation="[360,1030]" width="1470" color="0x86868CFF"
             text="Up/Down: channel    Left: mini guide    OK: hide    *: favorite    Replay: previous channel"><Font role="font" uri="pkg:/fonts/geist_regular.ttf" size="24" /></Label>
    </Group>

    <!-- The same game is already streaming on another channel: join it, or watch this one. -->
    <Group id="samePrompt" visible="false">
      <Rectangle translation="[460,330]" width="1000" height="420" color="0x141416F2" />
      <Label id="sameTitle" translation="[510,370]" width="900" wrap="true" maxLines="2" color="0xFFFFFFFF"><Font role="font" uri="pkg:/fonts/geist_bold.ttf" size="40" /></Label>
      <Label id="sameBody" translation="[510,480]" width="900" wrap="true" maxLines="2" color="0xA3A3A8FF"><Font role="font" uri="pkg:/fonts/geist_regular.ttf" size="28" /></Label>
      <LabelList id="sameList" translation="[510,575]" itemSize="[900,64]" itemSpacing="[0,8]" numRows="2"
                 color="0xEDEDEDFF" focusedColor="0x0A0A0BFF" focusBitmapBlendColor="0xFF8200FF"
                 font="font:SmallBoldSystemFont" focusedFont="font:SmallBoldSystemFont" vertFocusAnimationStyle="floatingFocus" />
    </Group>
    <Group id="sameNotice" visible="false">
      <Rectangle translation="[360,50]" width="1200" height="72" color="0x000000C0" />
      <Label id="sameNoticeText" translation="[360,50]" width="1200" height="72" horizAlign="center" vertAlign="center" color="0xFFFFFFFF"><Font role="font" uri="pkg:/fonts/geist_semibold.ttf" size="28" /></Label>
    </Group>

    <Group id="mini" visible="false">
      <Rectangle width="680" height="1080" color="0x000000E6" />
      <Label id="miniTitle" translation="[40,40]" width="600" color="0xFFFFFFFF"><Font role="font" uri="pkg:/fonts/geist_semibold.ttf" size="34" /></Label>
      <MarkupList id="miniList" translation="[30,110]" itemComponentName="MiniItem" itemSize="[620,84]"
                  itemSpacing="[0,6]" numRows="10" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" />
    </Group>

    <Timer id="infoTimer" duration="5" repeat="false" />
    <Timer id="zapTimer" duration="0.45" repeat="false" />
    <Timer id="retryTimer" duration="2" repeat="false" />
    <Timer id="stallTimer" duration="12" repeat="false" />
    <Timer id="badgeTimer" duration="1.5" repeat="false" />
    <Timer id="recentTimer" duration="5" repeat="false" />
    <Timer id="sameTimer" duration="2.5" repeat="false" />
    <Timer id="sameNoticeTimer" duration="6" repeat="false" />
    <Timer id="clockTimer" duration="15" repeat="true" />
  </children>
</component>
